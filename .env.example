# Copy to .env for local `netlify dev`. In production set these in
# Netlify → Site configuration → Environment variables.

# Password for the admin login page (/admin/login). Required.
ADMIN_PASSWORD=change-me-to-something-long

# Secret used to sign login tokens. Use a long random string:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
